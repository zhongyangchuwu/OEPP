# Copy to .env. Keep the real file private and mode 600.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=

# SiliconFlow Qwen3-VL (used by configs/siliconflow_qwen3vl32_tablev_t4_3x3.yaml)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_QWEN_MODEL=Qwen/Qwen3-VL-32B-Instruct

# OpenRouter Gemini 3.1 Flash Lite (used by configs/openrouter_gemini31flashlite_tablev_t4_3x3.yaml)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_GEMINI_MODEL=google/gemini-3.1-flash-lite

# OpenRouter Gemini 3 Flash Preview (used by configs/openrouter_gemini3flashpreview_tablev_t4_3x3.yaml)
OPENROUTER_GEMINI3_FLASH_PREVIEW_MODEL=google/gemini-3-flash-preview
